SECTIONS
{
    .psram_text :
    {
        *(.text*)
        . = ALIGN(4);
        *(.init) *(.fini)
        *crtbegin.o(.ctors) *crtbegin?.o(.ctors)
        *(EXCLUDE_FILE(*crtend?.o *crtend.o) .ctors)
        *(SORT(.ctors.*)) *(.ctors)
        *crtbegin.o(.dtors) *crtbegin?.o(.dtors)
        *(EXCLUDE_FILE(*crtend?.o *crtend.o) .dtors)
        *(SORT(.dtors.*)) *(.dtors)
        *(.eh_frame*)
    } > PSRAM
    .psram_rodata :
    {
        . = ALIGN(4);
        *(.rodata*) *(.srodata*)
        *(SORT_BY_ALIGNMENT(SORT_BY_NAME(.flashdata*)))
        . = ALIGN(4);
    } > PSRAM
}
