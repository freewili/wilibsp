        *watchdog.c.obj(.text* .rodata* .srodata*)
        *bootrom.c.obj(.text* .rodata* .srodata*)
        *bootrom_lock.c.obj(.text* .rodata* .srodata*)
        *flash.c.obj(.text* .rodata* .srodata*)
        *xosc.c.obj(.text* .rodata* .srodata*)
        *boot_lock.c.obj(.text* .rodata* .srodata*)
